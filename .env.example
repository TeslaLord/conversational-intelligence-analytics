# Every value below is REQUIRED. Pipeline aborts if any is missing.

# --- Data ---
# Paths may be absolute OR relative to the project root (the folder
# containing this .env file). Defaults below assume you drop the CSV next
# to this file and let the pipeline write its artefacts into ./data.
CSV_PATH=./customer_support_data.csv
DATA_DIR=./data
SUBSET_SIZE=1000
RANDOM_SEED=42

# --- HF models (downloaded once, then cached locally) ---
# Small multilingual embedder (~120MB). Swap to BAAI/bge-m3 (~2GB) for higher quality.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# --- LLM (any OpenAI-compatible endpoint: OpenAI, OpenRouter, vLLM, Ollama, ...) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
TAGGING_LLM_MODEL=gpt-4o-mini
SYNTH_LLM_MODEL=gpt-4o-mini
# Same model for judge is not ideal (self-preference risk) but fine for a prototype
# when you only have one provider; swap to gpt-4o for stricter evaluation.
JUDGE_LLM_MODEL=gpt-4o-mini

# --- Tagging budget ---
TAGGING_MAX_CONVERSATIONS=1000
TAGGING_CONCURRENCY=6

# --- Retrieval ---
TOP_K_DENSE=20
TOP_K_FINAL=5

# --- PII salt (any non-empty random string) ---
PII_HASH_SALT=please-replace-with-random-bytes
